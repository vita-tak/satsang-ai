{
  "$description": "Satsang AI design tokens (Design Tokens Community Group format). The implementation's source of truth is src/app/globals.css; keep this file in sync with it.",
  "color": {
    "light": {
      "$description": "Ash theme",
      "ground": { "$type": "color", "$value": "#dad9d5", "$description": "Page background" },
      "ink": { "$type": "color", "$value": "#1c1b19", "$description": "Answers, headings, wordmark, typed input. 12.2:1" },
      "ink-soft": { "$type": "color", "$value": "#45413b", "$description": "The seeker's words, intro line, prompts. 7.2:1" },
      "ink-faint": { "$type": "color", "$value": "#5c5750", "$description": "Labels, placeholder, idle controls. 5.1:1" },
      "rule": { "$type": "color", "$value": "#b9b7b2", "$description": "Hairlines only, never text. 1.4:1" },
      "accent": { "$type": "color", "$value": "#963e13", "$description": "Ember: the point, Ask, focus, caret. 5.0:1" },
      "error": { "$type": "color", "$value": "#94281e", "$description": "Inline error text. 5.8:1" }
    },
    "dark": {
      "$description": "Char theme",
      "ground": { "$type": "color", "$value": "#131211", "$description": "Page background" },
      "ink": { "$type": "color", "$value": "#ddd8ce", "$description": "Answers, headings, wordmark, typed input. 13.2:1" },
      "ink-soft": { "$type": "color", "$value": "#a8a195", "$description": "The seeker's words, intro line, prompts. 7.3:1" },
      "ink-faint": { "$type": "color", "$value": "#858075", "$description": "Labels, placeholder, idle controls. 4.8:1" },
      "rule": { "$type": "color", "$value": "#34312d", "$description": "Hairlines only, never text. 1.5:1" },
      "accent": { "$type": "color", "$value": "#e2894f", "$description": "Ember: the point, Ask, focus, caret. 7.1:1" },
      "error": { "$type": "color", "$value": "#ef8a7a", "$description": "Inline error text. 7.7:1" }
    },
    "ember-neutral": { "$type": "color", "$value": "#c8683a", "$description": "Favicon and other surfaces that cannot follow the theme" }
  },
  "font": {
    "serif": { "$type": "fontFamily", "$value": ["EB Garamond", "Georgia", "serif"], "$description": "The guide's voice" },
    "sans": { "$type": "fontFamily", "$value": ["Mukta", "system-ui", "sans-serif"], "$description": "The seeker's voice and the interface. Weight 400 only." }
  },
  "text": {
    "display": { "$type": "dimension", "$value": "2.125rem", "$extensions": { "lineHeight": 1.15, "letterSpacing": "-0.01em", "fontWeight": 400 } },
    "display-lg": { "$type": "dimension", "$value": "2.75rem", "$extensions": { "lineHeight": 1.12, "letterSpacing": "-0.015em", "fontWeight": 400 } },
    "reading": { "$type": "dimension", "$value": "1.1875rem", "$extensions": { "lineHeight": 1.6 } },
    "reading-lg": { "$type": "dimension", "$value": "1.3125rem", "$extensions": { "lineHeight": 1.6 } },
    "body": { "$type": "dimension", "$value": "1.0625rem", "$extensions": { "lineHeight": 1.6 } },
    "body-lg": { "$type": "dimension", "$value": "1.125rem", "$extensions": { "lineHeight": 1.6 } },
    "note": { "$type": "dimension", "$value": "0.9375rem", "$extensions": { "lineHeight": 1.5 } },
    "label": { "$type": "dimension", "$value": "0.75rem", "$extensions": { "lineHeight": 1.4, "letterSpacing": "0.16em", "textTransform": "uppercase" } }
  },
  "layout": {
    "measure": { "$type": "dimension", "$value": "39rem", "$description": "Reading column width" },
    "gutter": { "$type": "dimension", "$value": "1.5rem", "$description": "Side gutter on phones" },
    "gutter-wide": { "$type": "dimension", "$value": "2rem", "$description": "Side gutter from 640px" },
    "breakpoint": { "$type": "dimension", "$value": "40rem", "$description": "The only breakpoint (Tailwind sm)" },
    "touch-target": { "$type": "dimension", "$value": "44px", "$description": "Minimum size of any interactive element" },
    "point": { "$type": "dimension", "$value": "6px", "$description": "The ember point" },
    "radius": { "$type": "dimension", "$value": "0px", "$description": "Square corners everywhere; only the point is round" }
  },
  "motion": {
    "breath": { "$type": "cubicBezier", "$value": [0.37, 0, 0.63, 1], "$description": "The only easing curve" },
    "duration-arrive": { "$type": "duration", "$value": "1200ms", "$description": "Answers and intro items" },
    "duration-question": { "$type": "duration", "$value": "800ms", "$description": "A sent question fading in" },
    "duration-leave": { "$type": "duration", "$value": "700ms", "$description": "The intro dissolving" },
    "duration-hover": { "$type": "duration", "$value": "500ms", "$description": "Hover and focus colour changes" },
    "duration-theme": { "$type": "duration", "$value": "700ms", "$description": "Theme cross-fade" },
    "breathe-cycle": { "$type": "duration", "$value": "4000ms", "$description": "The Answering pulse, opacity 0.35 to 1 and back" },
    "rise": { "$type": "dimension", "$value": "8px", "$description": "Maximum movement on arrival" }
  }
}
